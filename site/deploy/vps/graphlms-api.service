[Unit]
Description=GraphLMS accounts and progress
After=network.target

[Service]
User=graphlms
Group=graphlms
WorkingDirectory=/opt/graphlms/site/api
EnvironmentFile=/etc/graphlms/api.env
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/graphlms

[Install]
WantedBy=multi-user.target
