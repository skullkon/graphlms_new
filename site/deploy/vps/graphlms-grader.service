[Unit]
Description=GraphLMS Go grading queue
After=network.target graphlms-executor.service
Wants=graphlms-executor.service

[Service]
User=graphlms
Group=graphlms
WorkingDirectory=/opt/graphlms/current/site/grader
EnvironmentFile=/etc/graphlms/grader.env
ExecStart=/opt/graphlms/current/site/grader/grader-linux-arm64
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=192M

[Install]
WantedBy=multi-user.target
